# Environment variables for Nexen
# Copy this file to .env and fill in your actual values

# Server port (default: 3000)
PORT=3000

# Google Gemini API Key - Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative name (also supported)
API_KEY=your_gemini_api_key_here

# MongoDB connection string (default: mongodb://localhost:27017/nexen)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/nexen?retryWrites=true&w=majority
MONGODB_DB_NAME=nexen

# JWT Secret for authentication tokens
JWT_SECRET=your_strong_jwt_secret_here